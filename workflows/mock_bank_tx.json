{
  "version": "1.0",
  "name": "Mock Bank Transaction",
  "description": "Search for member 12345, navigate to their dashboard, initiate a savings transaction of 500, reach the confirmation page, and extract the full text of the paragraph that starts with 'Successfully processed' into a variable named 'transaction_receipt'.",
  "inputs": [
    "member_id",
    "amount"
  ],
  "outputs": [
    "transaction_receipt"
  ],
  "steps": [
    {
      "action": "type",
      "locator": {
        "strategy": "placeholder",
        "value": "Enter ID...",
        "name": null
      },
      "value": "12345",
      "extract_as": null
    },
    {
      "action": "click",
      "locator": {
        "strategy": "role",
        "value": "button",
        "name": "Search Database"
      },
      "value": null,
      "extract_as": null
    },
    {
      "action": "click",
      "locator": {
        "strategy": "role",
        "value": "link",
        "name": "Transact"
      },
      "value": null,
      "extract_as": null
    },
    {
      "action": "type",
      "locator": {
        "strategy": "role",
        "value": "spinbutton",
        "name": null
      },
      "value": "500",
      "extract_as": null
    },
    {
      "action": "click",
      "locator": {
        "strategy": "role",
        "value": "button",
        "name": "Submit Transaction"
      },
      "value": null,
      "extract_as": null
    },
    {
      "action": "read_text",
      "locator": {
        "strategy": "role",
        "value": "paragraph",
        "name": null
      },
      "value": null,
      "extract_as": "transaction_receipt"
    }
  ],
  "success_condition": {
    "strategy": "text",
    "value": "Successfully processed",
    "name": null
  },
  "expected_outcomes": [
    {
      "name": "record_not_found",
      "locator": {
        "strategy": "text",
        "value": "No active accounts found",
        "name": null
      }
    }
  ]
}